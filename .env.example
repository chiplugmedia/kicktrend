# ==============================================================================
# Kicktrend Environment Configuration Template
# ==============================================================================

# 1. DATABASE CONFIGURATION (Individual Fields)
# ------------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="wanblog"

# Automatically combines the fields above for Prisma:
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (use a random string in production)
JWT_SECRET="kicktrend_super_secret_jwt_key_2026_change_in_production"

# 3. PUBLIC SITE URL (Used for sitemaps, SEO, and canonical links)
# ------------------------------------------------------------------------------
# Local:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production:
# NEXT_PUBLIC_SITE_URL="https://kicktrend.vercel.app"
