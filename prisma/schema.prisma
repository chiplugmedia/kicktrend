datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  email       String    @unique
  password    String
  role        String    @default("user") // "user" | "admin"
  status      String    @default("active") // "active" | "pending" | "suspended"
  name        String?
  phone       String?
  avatar      String?
  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts     Post[]
  comments  Comment[]
  likes     Like[]
}

model Post {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  summary        String    @db.Text
  content        String    @db.LongText
  coverImage     String?
  videoUrl       String?
  category       String
  tags           String
  hashtags       String
  readTime       Int       @default(3)
  views          Int       @default(0)
  published       Boolean   @default(true)
  status          String    @default("approved") // "pending" | "approved" | "rejected"
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorUsername String
  author         User      @relation(fields: [authorUsername], references: [username], onDelete: Cascade)

  comments       Comment[]
  likes          Like[]

  @@index([category])
  @@index([authorUsername])
  @@index([createdAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model SiteStat {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. "total_visits"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DailyVisit {
  id        Int      @id @default(autoincrement())
  date      String   @unique // "YYYY-MM-DD"
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorLog {
  id          Int      @id @default(autoincrement())
  ip          String
  country     String   @default("Unknown")
  countryCode String   @default("XX")
  city        String?
  path        String   @default("/")
  date        String
  createdAt   DateTime @default(now())

  @@index([ip])
  @@index([date])
  @@index([countryCode])
  @@index([createdAt])
  @@map("visitorlog")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. "twitter_url", "tiktok_url", "instagram_url"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Comment {
  id             Int      @id @default(autoincrement())
  content        String   @db.Text
  createdAt      DateTime @default(now())
  postId         Int
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorUsername String
  author         User     @relation(fields: [authorUsername], references: [username], onDelete: Cascade)

  @@index([postId])
  @@index([authorUsername])
}

model Like {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  postId         Int
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorUsername String
  author         User     @relation(fields: [authorUsername], references: [username], onDelete: Cascade)

  @@unique([postId, authorUsername])
  @@index([postId])
  @@index([authorUsername])
}
